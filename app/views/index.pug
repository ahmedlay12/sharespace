extends layout

block content
  .page
    .hero
      h1 Share. Swap. Save.
      p A community platform for Roehampton students to exchange items, reduce waste, and help each other out.
      if loggedInUser
        a.btn(href='/create-listing') + Post a Listing
      else
        .hero-btns
          a.btn(href='/listings') Browse Listings
          a.btn-outline(href='/register') Join ShareSpace

    h2 Explore
    .cards
      a.card(href='/listings')
        .card-icon
          svg(xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z")
        h3 Listings
        p Browse items students are giving away or looking to exchange.
      a.card(href='/categories')
        .card-icon
          svg(xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z")
            line(x1="7" y1="7" x2="7.01" y2="7")
        h3 Categories
        p Find items by type — books, electronics, kitchen essentials and more.
      a.card(href='/users')
        .card-icon
          svg(xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2")
            circle(cx="9" cy="7" r="4")
            path(d="M23 21v-2a4 4 0 0 0-3-3.87")
            path(d="M16 3.13a4 4 0 0 1 0 7.75")
        h3 Students
        p See who is on ShareSpace and check their ratings.
