extends layout

block content
  .page
    h1 Students
    .grid
      each user in data
        .item-card
          h3= user.name
          p.meta University of Roehampton
          p.meta= user.location
          if user.avg_rating
            p.rating ⭐ #{user.avg_rating} / 5 (#{user.rating_count} reviews)
          else
            p.muted No ratings yet
          p.bio-preview= user.bio
          a.btn-small(href='/users/' + user.id) View Profile
