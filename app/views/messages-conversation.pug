extends layout

block content
  .page
    a.back(href='/messages') &larr; Back to Messages
    .page-header
      h1 Conversation with #{otherUser.name}
      a.btn-small(href='/users/' + otherUser.id) View Profile

    .chat-box
      each msg in messages
        .chat-bubble(class=msg.sender_id == loggedInUser.id ? 'chat-mine' : 'chat-theirs')
          .chat-name #{msg.sender_name}
          .chat-content #{msg.content}

    if loggedInUser
      form.chat-form(action='/messages/' + otherUser.id method='POST')
        .chat-input-row
          input(type='text' name='content' placeholder='Type a message...' required autocomplete='off')
          button.btn(type='submit') Send
